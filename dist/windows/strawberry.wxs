<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v6 source for the Strawberry MSI package, built by dist/windows/build-msi.ps1.
  Every file in the staging directory (StageDir) is harvested, so there is no per-file list to maintain like in strawberry.nsi.in.
  Required preprocessor variables: StageDir, Version, LicenseRtf.
  The FileAssociations component is generated by build-msi.ps1 from its extension table, the WiX preprocessor has no maps.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define ProductName = "Strawberry Music Player" ?>
  <?define ProgId = "Strawberry Music Player" ?>
  <?define CapabilitiesPath = "Software\Clients\Media\Strawberry" ?>

  <Package Name="$(ProductName)" Manufacturer="Jonas Kvinge" Version="$(Version)" UpgradeCode="{6A3F2B4E-9C1D-4E7A-8B5F-2D0C7E9A1F34}" Scope="perMachine" Language="1033">

    <!-- Development builds share the same version, so allow them to replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="strawberry.ico" SourceFile="$(StageDir)\strawberry.ico" />
    <Property Id="ARPPRODUCTICON" Value="strawberry.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.strawberrymusicplayer.org/" />

    <!-- The NSIS installer and the MSI install to the same directory, refuse to install over an NSIS installation. -->
    <Property Id="NSISUNINSTALLER64">
      <RegistrySearch Id="NsisUninstaller64" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Strawberry" Name="UninstallString" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="NSISUNINSTALLER32">
      <RegistrySearch Id="NsisUninstaller32" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Strawberry" Name="UninstallString" Type="raw" Bitness="always32" />
    </Property>
    <Launch Condition="Installed OR (NOT NSISUNINSTALLER64 AND NOT NSISUNINSTALLER32)" Message="$(ProductName) is already installed with the setup program (.exe). Uninstall it first, then run this installer again." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="$(ProductName)" />
    </StandardDirectory>

    <Feature Id="Main" Title="$(ProductName)" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Registration" />
      <ComponentRef Id="FileAssociations" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="StrawberryExe">
        <File Id="StrawberryExe" Source="$(StageDir)\strawberry.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="$(ProductName)" WorkingDirectory="INSTALLFOLDER" Icon="strawberry.ico" Advertise="no" />
        </File>
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
      </Component>
      <Files Include="$(StageDir)\**">
        <Exclude Files="$(StageDir)\strawberry.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- Same registry entries as Capabilities.nsh and the NSIS installer: Default Programs registration and the tidal URL scheme. -->
  <Fragment>
    <Component Id="Registration" Directory="INSTALLFOLDER">

      <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="$(ProductName)" Type="string" Value="$(CapabilitiesPath)\Capabilities" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="$(CapabilitiesPath)" Type="string" Value="$(ProductName)" />
      <RegistryValue Root="HKLM" Key="$(CapabilitiesPath)" Name="LocalizedString" Type="string" Value="Strawberry" />
      <RegistryValue Root="HKLM" Key="$(CapabilitiesPath)\DefaultIcon" Type="string" Value="[INSTALLFOLDER]strawberry.ico" />
      <RegistryValue Root="HKLM" Key="$(CapabilitiesPath)\Capabilities" Name="ApplicationName" Type="string" Value="Strawberry" />
      <RegistryValue Root="HKLM" Key="$(CapabilitiesPath)\Capabilities" Name="ApplicationDescription" Type="string" Value="$(ProductName)" />

      <RegistryValue Root="HKLM" Key="Software\Classes\tidal" Type="string" Value="URL:tidal" />
      <RegistryValue Root="HKLM" Key="Software\Classes\tidal" Name="URL Protocol" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="Software\Classes\tidal\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]strawberry.exe&quot; &quot;%1&quot;" />

    </Component>
  </Fragment>

</Wix>
